# Production / development-server settings (grammaster.arsus.it). Copy to .env on the server and fill in the blanks.
APP_NAME=GramMaster
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://grammaster.arsus.it

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# The database created in Plesk > Databases (use 127.0.0.1, not "localhost", to force TCP).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

# Plesk's nginx terminates HTTPS and forwards to Apache on this machine (from the server's own address, not
# necessarily 127.0.0.1). Trust it so URLs are built as https://.
TRUSTED_PROXIES=*

# Same origin as the app (the student app is served under /student/ on the same domain).
SPA_URL=https://grammaster.arsus.it
SANCTUM_TOKEN_EXPIRATION=43200

MAIL_MAILER=log
BCRYPT_ROUNDS=12
