# Host user (so files created in containers are owned by you). Run `id -u` / `id -g`.
UID=501
GID=20

# Published ports
NGINX_PORT=8088
MYSQL_PORT=3307
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# MySQL
DB_DATABASE=grammatica
DB_USERNAME=grammatica
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# One address for everything: /student (app), /admin, /api. The app calls the API on the same origin.
APP_URL=http://localhost:8088
SPA_URL=http://localhost:8088
VITE_API_BASE_URL=/api/v1
